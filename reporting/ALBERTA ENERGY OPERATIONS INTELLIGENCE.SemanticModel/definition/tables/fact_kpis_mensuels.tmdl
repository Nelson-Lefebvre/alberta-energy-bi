		dataType: double
		lineageTag: df065a8e-d755-4be3-b375-0e5e534f0f56
		summarizeBy: none
		sourceColumn: capex_total_cad

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column co2_tonnes
		dataType: double

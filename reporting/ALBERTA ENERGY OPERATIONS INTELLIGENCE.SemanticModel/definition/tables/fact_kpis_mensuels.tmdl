table fact_kpis_mensuels
	lineageTag: 5b516698-c10c-42ae-aab1-cb684b812375

	/// Cible d'intensité carbone Alberta 2030 (tCO2/boe).
	measure ValeurCible = 0.040
		formatString: 0.000
		lineageTag: b998b5ae-a687-4268-b383-5ad668d3a6d9

	/// Production totale en barils équivalent pétrole (fait détaillé).
	measure 'Production BOE' = SUM ( fact_production_enriched[volume_boe] )
		formatString: #,0.000
		displayFolder: 1 Production
		lineageTag: 7f000001-0000-4000-8000-000000000001

	/// Nombre de puits ayant produit (sur le filtre courant).
	measure 'Nb puits producteurs' = DISTINCTCOUNT ( fact_production_enriched[uwi] )
		formatString: #,0
		displayFolder: 1 Production
		lineageTag: 7f000001-0000-4000-8000-000000000002

	/// Production moyenne par puits producteur — le vrai différenciateur entre opérateurs.
	measure 'Production par puits' = DIVIDE ( [Production BOE], [Nb puits producteurs] )
		formatString: #,0
		displayFolder: 1 Production
		lineageTag: 7f000001-0000-4000-8000-000000000003

	/// Production du dernier mois de la période.
	measure 'Production dernier mois' = CALCULATE ( [Production BOE], LASTDATE ( dim_date[date] ) )
		formatString: #,0
		displayFolder: 1 Production
		lineageTag: 0ecfd8c8-bec1-45af-b546-4855dc050d3a

	/// Moyenne mobile 3 mois de la production (lissage de tendance).
	measure 'Production MM3' = AVERAGEX ( DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH ), [Production BOE] )
		formatString: #,0
		displayFolder: 1 Production
		lineageTag: 7f000001-0000-4000-8000-000000000004

	/// Production des 12 derniers mois (run-rate annualisé).
	measure 'Run-rate annualisé' = CALCULATE ( [Production BOE], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH ) )
		formatString: #,0
		displayFolder: 1 Production
		lineageTag: 7f000001-0000-4000-8000-000000000005

	/// Part de production de la région dans le total (toutes régions confondues).
	/// REMOVEFILTERS porte sur dim_region, pas sur la colonne du fait : les slicers région
	/// des pages filtrent la dimension conforme, et retirer le filtre côté fait n'aurait
	/// donc rien retiré du tout — le dénominateur restait filtré et la mesure renvoyait
	/// 100 % en permanence.
	measure 'Part région production %' = DIVIDE ( [Production BOE], CALCULATE ( [Production BOE], REMOVEFILTERS ( dim_region ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Production
		lineageTag: 7f000001-0000-4000-8000-000000000006

	/// Revenu estimé (volume BOE × prix WCS CAD) — déjà calculé dans le mart.
	measure 'Revenu Estimé CAD' = SUM ( fact_production_enriched[revenu_estime_cad] )
		formatString: \$#,0.000;-\$#,0.000;\$#,0.000
		displayFolder: 2 Finance
		lineageTag: 7f000002-0000-4000-8000-000000000001

		annotation PBI_FormatHint = {"currencyCulture":"af-NA"}

	/// OPEX total (forage + maintenance). Lu sur fact_production_enriched, au grain
	/// puits × mois × produit : c'est ce qui permet aux slicers opérateur, statut, uwi
	/// et type de produit de filtrer l'OPEX. La version agrégée (mois × région) de
	/// fact_kpis_mensuels ne pouvait être atteinte par aucun de ces filtres.
	measure 'OPEX Total CAD' = SUM ( fact_production_enriched[opex_cad] )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: 2 Finance
		lineageTag: 7f000002-0000-4000-8000-000000000002

	/// CAPEX total (investissement ponctuel, corrigé dans le mart dbt).
	measure 'CAPEX Total CAD' = SUM ( fact_kpis_mensuels[capex_total_cad] )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: 2 Finance
		lineageTag: 7f000002-0000-4000-8000-000000000003

	/// OPEX par baril équivalent pétrole — ratio des sommes (exact). Numérateur et
	/// dénominateur sont désormais pris sur le même fait, donc le ratio reste juste
	/// sous n'importe quel filtre (opérateur, produit, puits, statut, date, région).
	measure 'OPEX par boe' = DIVIDE ( [OPEX Total CAD], [Production BOE] )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 2 Finance
		lineageTag: 7f000002-0000-4000-8000-000000000004

	/// Revenu par baril équivalent pétrole.
	measure 'Revenu par boe' = DIVIDE ( [Revenu Estimé CAD], [Production BOE] )
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		displayFolder: 2 Finance
		lineageTag: 7f000002-0000-4000-8000-000000000005

	/// Marge opérationnelle = (Revenu − OPEX) / Revenu. Revenu et OPEX sont tous deux
	/// pris sur fact_production_enriched, donc au même grain et cohérents sous n'importe
	/// quel filtre. HORS redevances, transport et G&A (indisponibles par puits) : c'est
	/// une marge OPÉRATOIRE (opex-only), PAS une marge nette — ne pas lire comme une rentabilité.
	measure 'Marge Opérationnelle %' = DIVIDE ( [Revenu Estimé CAD] - [OPEX Total CAD], [Revenu Estimé CAD] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2 Finance
		lineageTag: 7f000002-0000-4000-8000-000000000006

	/// Émissions CO2 directes Scope 1 (tonnes). Lu sur fact_production_enriched pour la
	/// même raison que l'OPEX : rendre la mesure filtrable par opérateur, puits et produit.
	measure 'CO2 Scope 1 (t)' = SUM ( fact_production_enriched[co2_tonnes] )
		formatString: #,0
		displayFolder: 3 ESG
		lineageTag: 7f000003-0000-4000-8000-000000000001

	/// CO2 équivalent total (CO2 + CH4 × 28, GWP100 GIEC AR6), grain région × scope.
	measure 'CO2eq Total (t)' = SUM ( fact_emissions_scope[co2eq_total] )
		formatString: #,0
		displayFolder: 3 ESG
		lineageTag: 7f000003-0000-4000-8000-000000000002

	/// Intensité carbone = CO2 / production (ratio des sommes, exact). Même fait au
	/// numérateur et au dénominateur : le ratio reste juste sous n'importe quel filtre.
	measure 'Intensité carbone' = DIVIDE ( [CO2 Scope 1 (t)], [Production BOE] )
		formatString: 0.000
		displayFolder: 3 ESG
		lineageTag: 7f000003-0000-4000-8000-000000000003

	/// Écart à la cible 2030 (positif = au-dessus de la cible, donc moins bon).
	measure 'Écart cible 2030 %' = DIVIDE ( [Intensité carbone] - [ValeurCible], [ValeurCible] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 ESG
		lineageTag: 6975068b-211c-4bac-a7e7-46f708a60911

	/// Production des 12 derniers mois.
	measure 'Production 12 derniers mois' = CALCULATE ( [Production BOE], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -12, MONTH ) )
		formatString: #,0
		displayFolder: 4 Time Intelligence
		lineageTag: 7f000004-0000-4000-8000-000000000001

	/// Production des 12 mois précédant les 12 derniers.
	measure 'Production 12 mois précédents' = CALCULATE ( [Production BOE], DATESINPERIOD ( dim_date[date], EDATE ( MAX ( dim_date[date] ), -12 ), -12, MONTH ) )
		formatString: #,0
		displayFolder: 4 Time Intelligence
		lineageTag: 7f000004-0000-4000-8000-000000000002

	/// Tendance d'une année sur l'autre (12 derniers mois vs 12 précédents).
	measure 'Tendance YoY %' = DIVIDE ( [Production 12 derniers mois] - [Production 12 mois précédents], [Production 12 mois précédents] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Time Intelligence
		lineageTag: 7f000004-0000-4000-8000-000000000003

	/// Production moyenne par mois sur la période filtrée.
	measure 'Production moyenne mensuelle' = AVERAGEX ( VALUES ( dim_date[date_key] ), [Production BOE] )
		formatString: #,0
		displayFolder: 4 Time Intelligence
		lineageTag: 7f000004-0000-4000-8000-000000000004

	/// Écart-type de la production mensuelle.
	measure 'Écart-type production mensuelle' = STDEVX.P ( VALUES ( dim_date[date_key] ), [Production BOE] )
		formatString: #,0
		displayFolder: 4 Time Intelligence
		lineageTag: 7f000004-0000-4000-8000-000000000005

	/// Coefficient de variation de la production (stabilité du plateau).
	measure 'Variabilité CV %' = DIVIDE ( [Écart-type production mensuelle], [Production moyenne mensuelle] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Time Intelligence
		lineageTag: 7f000004-0000-4000-8000-000000000006

	/// Classement des puits par revenu estimé (1 = meilleur).
	measure 'Rang Revenu Puits' = IF ( HASONEVALUE ( dim_puits[uwi] ), RANKX ( ALL ( dim_puits[uwi] ), [Revenu Estimé CAD],, DESC, Dense ) )
		formatString: #,0
		displayFolder: 5 Puits
		lineageTag: 7f000005-0000-4000-8000-000000000001

	/// Nombre de puits au statut ACTIVE.
	measure 'Nb puits ACTIVE' = CALCULATE ( DISTINCTCOUNT ( dim_puits[uwi] ), dim_puits[status] = "ACTIVE" )
		formatString: #,0
		displayFolder: 5 Puits
		lineageTag: 7f000005-0000-4000-8000-000000000002

	/// Nombre de puits au statut ABANDONED (angle passif / liability).
	measure 'Nb puits ABANDONED' = CALCULATE ( DISTINCTCOUNT ( dim_puits[uwi] ), dim_puits[status] = "ABANDONED" )
		formatString: #,0
		displayFolder: 5 Puits
		lineageTag: 7f000005-0000-4000-8000-000000000003

	column date_key

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column opex_par_boe
		dataType: double
		formatString: \$#,0.00;-\$#,0.00;\$#,0.00
		lineageTag: 344f4ebb-8ed6-4c01-8d66-b79fcf623d8f
		summarizeBy: none
		sourceColumn: opex_par_boe

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"currencyCulture":"en-CA"}

	column intensite_carbone
		dataType: double

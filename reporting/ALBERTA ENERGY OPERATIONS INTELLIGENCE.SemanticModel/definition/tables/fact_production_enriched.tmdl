table fact_production_enriched
	lineageTag: 7e9e27d8-415f-45cf-9422-5258626b83b5

	measure 'Moyenne mobile de Moyenne de production_cumulative_boe' =
			
			IF(
				ISFILTERED('dim_puits'[spud_date]),
				ERROR("Les mesures rapides de Time Intelligence peuvent être regroupées ou filtrées seulement par la hiérarchie de dates ou les colonnes de dates principales fournies par Power BI."),
				VAR __LAST_DATE = ENDOFMONTH('dim_puits'[spud_date].[Date])
				VAR __DATE_PERIOD =
					DATESBETWEEN(
						'dim_puits'[spud_date].[Date],
						STARTOFMONTH(DATEADD(__LAST_DATE, -3, MONTH)),
						__LAST_DATE
					)
				RETURN
					AVERAGEX(
						CALCULATETABLE(
							SUMMARIZE(
								VALUES('dim_puits'),
								'dim_puits'[spud_date].[Année],
								'dim_puits'[spud_date].[NoTrimestre],
								'dim_puits'[spud_date].[Trimestre],
								'dim_puits'[spud_date].[NoMois],
								'dim_puits'[spud_date].[Mois]
							),
							__DATE_PERIOD
						),
						CALCULATE(
							AVERAGE('fact_production_enriched'[production_cumulative_boe]),
							ALL('dim_puits'[spud_date].[Jour])
						)
					)
			)
		lineageTag: 652887d2-76ac-4b9f-8313-e3d9c55f86cd

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "RollingAverage"
				}

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

